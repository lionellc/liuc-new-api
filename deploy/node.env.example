# Generated separately on each server by init-site.sh; never commit node.env.
# Use hexadecimal passwords to avoid URL-encoding issues in connection strings.
POSTGRES_PASSWORD=REPLACE_POSTGRES_PASSWORD
REDIS_PASSWORD=REPLACE_REDIS_PASSWORD

# Check host routes and Docker networks before using this subnet.
# If changed, also update TRUSTED_PROXIES in app.env before the first deployment.
DOCKER_SUBNET=172.29.250.0/24
DOCKER_GATEWAY=172.29.250.1
