# Generated separately on each server by init-site.sh; never commit app.env.
TZ=Asia/Shanghai
GIN_MODE=release
PORT=3000
DEFAULT_LANGUAGE=zh-CN

# compose.yaml fixes NODE_TYPE=master for each independent new-api site.
NODE_NAME=REPLACE_SITE_NAME
SESSION_SECRET=REPLACE_SESSION_SECRET
CRYPTO_SECRET=REPLACE_CRYPTO_SECRET

# HTTPS terminates at the host Nginx; browser cookies still require Secure=true.
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_TRUSTED_URL=REPLACE_SITE_ORIGIN
TRUSTED_PROXIES=127.0.0.1,172.29.250.1

MEMORY_CACHE_ENABLED=true
SYNC_FREQUENCY=30
UPDATE_TASK=true
ERROR_LOG_ENABLED=true
BATCH_UPDATE_ENABLED=false
SQL_MAX_IDLE_CONNS=5
SQL_MAX_OPEN_CONNS=20
STREAMING_TIMEOUT=300
SHUTDOWN_TIMEOUT_SECONDS=120
